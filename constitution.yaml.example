# Project-specific values extracted from constitution.md.
# Edit this file to specialize the reusable constitution template.
schema_version: 2

project:
  name: custom-name
  kind: headless Python NLP service
  ui: false
  excluded_components: [R, Streamlit]
  integration_branch: master
  source_dir: src
  tests_dir: tests/fti
  docs_dir: docs
  apps_dir: apps
  cli_dir: cli
  scripts_dir: scripts
  sdd_dir: .specify/memory

sdd:
  constitution_file: .specify/memory/constitution.md
  spec_file: .specify/memory/SPEC.md
  plan_file: .specify/memory/PLAN.md
  tasks_file: .specify/memory/TASKS.md
  changelog_file: .specify/memory/CHANGELOG.md

runtime:
  language: Python
  version: ">=3.12,<3.13"
  package_manager: uv
  lockfile: uv.lock
  dependency_manifest: pyproject.toml
  forbidden_package_managers: [pip, poetry, conda]

devcontainer:
  config_file: .devcontainer/devcontainer.json
  name: Python with UV
  image: mcr.microsoft.com/devcontainers/python:1-3.11-bookworm
  features:
    ghcr.io/va-h/devcontainers-features/uv:1: {}
  forward_ports: []
  host_requirements:
    gpu: optional
  gpu:
    enabled: true
    runtime_argument: "--gpus=all"
    base_image_requires_cuda: false
    cuda_runtime_source: torch cu124 wheels
    local_host_assumption: GPU-equipped WSL2 host
    cpu_only_compatibility: false
    rebuild_required_after_change: true
    host_prerequisites:
      - NVIDIA driver
      - NVIDIA Container Toolkit configured for Docker, or Docker Desktop using the WSL 2 engine with GPU support
  run_args:
    - "--gpus=all"
    - "--env-file"
    - "${localWorkspaceFolder}/.env"
  environment_file:
    path: .env
    example: .env.example
    required_before_create: true
    bootstrap_command: "cp .env.example .env"
    committed: false
  host_environment:
    required_variables:
      - name: DATA_HOST_DIR
        source: localEnv
        required_before_launch: true
        purpose: host path to the shared data directory
  mounts:
    - source: "${localEnv:DATA_HOST_DIR}"
      target: /workspaces/data
      type: bind
      consistency: cached
      purpose: mount the shared data directory beside the repository workspace
      avoids_workspace_collision: true
  automatic_workspace_mount: /workspaces/fti-repository
  post_create_command: "bash scripts/init.sh"
  remote_user: default image user
  references:
    format: https://aka.ms/devcontainer.json
    python_template: https://github.com/devcontainers/templates/tree/main/src/python
    dockerfile_guide: https://containers.dev/guide/dockerfile
    features: https://containers.dev/features
    gpu_workaround: https://github.com/microsoft/vscode-remote-release/issues/9385

architecture:
  source_layout: flat module plus one local package
  flat_modules: [pipeline.py]
  local_package: fti
  local_package_responsibilities:
    - connection
    - schema
    - queries
    - corrections
    - taxonomy
    - LLM-as-judge evaluation
  entrypoints:
    apps:
      pattern: apps/*.py
      kind: FastAPI services
    cli:
      pattern: cli/*.py
      kind: argparse batch drivers
    scripts:
      pattern: scripts/*.py
      kind: one-shot operational scripts
    bootstrap: prepend src/ to sys.path before importing flat modules
    forbidden_alternative: installed console-script entry point

ml_nlp:
  framework: PyTorch
  torch_version: ">=2.4,<2.7"
  wheel_index: cu124
  libraries:
    - transformers
    - datasets
    - accelerate
    - evaluate
    - seqeval
    - huggingface_hub
  device_policy: CUDA when available, otherwise CPU
  cpu_support_required: true
  models:
    sentiment:
      checkpoint: mteb/SpanishSentimentClassification
      optional: false
  database:
      checkpoint: pysentimiento/robertuito-sentiment-analysis
      optional: false
  model_selection: pinned, never dynamic
  model_change_requires:
    - specification change
    - fti.eval comparison against current baseline
    - compatible model-card license review

service:
  framework: FastAPI
  framework_version: 0.141.1
  server: "uvicorn[standard]"
  application: apps/fti_api.py
  default_port: 8003
  docs_path: /docs
  outbound_http: "httpx[http2]"
  validation_library: pydantic
  validation_version: ">=2.0"
  exact_pin: [FastAPI, uvicorn, ruff]
  range_pin: [pydantic, numpy, tqdm]

storage:
  engine: SQLite
  topology:
    source:
      name: SOURCE
      access: attached read-only
      env: SOURCE_DATABASE_URL
    results:
      name: RESULTS
      access: read/write
      env: DATABASE_URL

optional_dependency_groups:
  eval:
    dependencies: ["strands-agents[openai]", mlflow]
    transitive_examples: [boto3, opentelemetry, mcp]
    must_not_be_required_to_import: fti
  notebook:
    dependencies: [pandas, openpyxl, ipykernel]

project_structure:
  tests:
    layout: mirrors src under tests/fti
    conftest: tests/fti/conftest.py
    config: pytest.ini
    pythonpath: "src ."
    hermetic: true
    fixtures:
      - minimal articles table
      - two-tier SOURCE/RESULTS databases
      - monkeypatched model loading
  docs:
    examples:
      - docs/db-topology.md
      - docs/category-taxonomy.md
      - docs/modules/fti.md
    migration_naming: date/topic
  config:
    ruff: .code_quality/ruff.toml
    ruff_root_pointer: ruff.toml
    mypy: .code_quality/mypy.ini
    pytest: pytest.ini

ai:
  components: pipeline checkpoint models
  fail_policy:
    missing_source_text: fail fast through require_source_text
    oversized_input: chunk with chunking.py and merge spans
    silent_truncation_allowed: false
  output_status: model predictions
  prohibited_claims:
    - verified fact
    - financial advice
    - ground truth
  human_corrections_module: fti.corrections
  evaluation:
    package: fti.eval
    tracker: MLflow
    baseline_doc: docs/evaluation.md
    spot_checks_sufficient_for_accuracy_claims: false

metrics:
  classification_stages: [sentiment]
  per_class_ovr:
    - precision
    - recall
    - F1
    - accuracy_ovr
  overall_offline:
    - accuracy
    - macro_F1
  comparison_format: one side-by-side table per evaluation set
  missing_historical_metrics: recompute from stored eval_judgement rows
  sentiment_reference: train_sentiment.py::make_compute_metrics
  aggregate_references:
    - fti.eval.metrics.aggregate_sentiment
  reporting_policy: always report or link the complete metric set for every tested candidate

environment:
  file: .env
  example_file: .env.example
  git_ignored: true
  load_location: pipeline.py import
  additional_load_dotenv_calls_allowed: false
  variables:
    core: [DATABASE_URL, SOURCE_DATABASE_URL, HF_TOKEN]
    eval: [LLM_API_KEY, LLM_MODEL, LLM_URL, MLFLOW_TRACKING_URI]

naming:
  mappings:
    sentiment: article_sentiment

agent:
  instruction_file: CLAUDE.md
  tracked: false
  must_exist: true
  init_command_if_missing: /init
  must_reference:
    - .specify/memory/constitution.md
    - .specify/memory/SPEC.md
  destructive_history_boundary:
    minimum_safe_pr: 12
    minimum_safe_commit: 53522e8
  scope_expansion_requires_approval:
    - new external service
    - new heavy dependency
    - SOURCE or RESULTS schema change
    - two-tier database contract change

commands:
  dependency_install: "uv sync"
  eval_install: "uv sync --group eval"
  notebook_install: "uv sync --group notebook"
  model_setup: "uv run python -m setup"
  service_start: "uv run apps/fti_api.py"
  pipeline_run: "uv run cli/fti_cli.py"
  evaluation_run: "uv run cli/fti_eval.py"
  evaluation_ui: "uv run mlflow ui"
  test: "uv run pytest"
  ci_test: "uv run pytest -q"
  lint: "uv run ruff check ."
  format_check: "uv run ruff format --check ."
  type_check: "uv run mypy --config-file=.code_quality/mypy.ini"
  pre_commit: "uv run pre-commit run --all-files"
  hooks_install: "uv run pre-commit install"

quality:
  commit_convention: Conventional Commits
  commit_hook: commitizen
  ci_file: .github/workflows/ci.yml
  ci_job: lint-and-test
  ci_gate_order:
    - "uv sync --group dev --group eval"
    - ruff check
    - ruff format --check
    - mypy
    - pytest -q
  evaluation_workflow:
    file: .github/workflows/eval.yml
    blocking: false
  pre_commit_checks:
    - check-yaml
    - check-case-conflict
    - debug-statements
    - detect-private-key
    - check-merge-conflict
    - check-added-large-files
    - ruff
    - mypy
    - commitizen
  suppressions_require_explanation: true

code_git:
  branch_prefixes: [fix, feat, docs, chore, refactor]
  direct_commits_to_integration_branch: false
  leave_worktree_on_pr_branch: true
  always_present_pr_url: true
  unrelated_work_on_inflight_pr: ask user before editing or branching
  verify_branch_freshness_before_editing: true
  secrets_must_not_be_committed: true

known_constraints:
  - The pipeline and API must import without the eval dependency group.
  - Every inference stage must run correctly on CPU.
  - Missing source text stops execution rather than generating empty or default predictions.
  - Model checkpoint replacement requires evaluation against the current baseline.
  - Evaluation comparisons use the same metric implementation and evaluation path for all candidates.
  - CI is the merge gate; the real LLM-as-judge workflow is non-blocking.
  - All Python, test, lint, type, and operational commands run through uv.
  - Distinct work must not be stacked onto an in-flight PR without a user scoping decision.

governance:
  version: 2.8.0
  ratified: 2026-09-11
  last_amended: 2026-09-27
  amendment_log_source: constitution.md